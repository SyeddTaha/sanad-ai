{
  "name": "root",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "tsx --test src/contracts/v1/*.test.ts",
    "test:contracts": "tsx --test src/contracts/v1/*.test.ts",
    "typecheck": "tsc --noEmit",
    "test:backend": "node --conditions=react-server --import tsx --test tests/backend/*.test.ts",
    "db:migrate": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --conditions=react-server --import tsx scripts/migrate.ts",
    "db:seed": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --conditions=react-server --import tsx scripts/seed-demo.ts",
    "test:backend:live": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --conditions=react-server --import tsx --test tests/integration/b01.live.test.ts",
    "test:b02:live": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --conditions=react-server --import tsx --test tests/integration/b02.live.test.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.2",
    "next": "16.4.6",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.17",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "^5"
  }
}
